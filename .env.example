# Copy this file to .env (same folder as package.json) and fill in. .env is never committed.

# --- ManageEngine ServiceDesk Plus Cloud (tickets) ---
SDP_BASE=https://sdpondemand.manageengine.com/app/itdesk
SDP_ACCOUNTS=https://accounts.zoho.com
SDP_CLIENT_ID=
SDP_CLIENT_SECRET=
SDP_REFRESH_TOKEN=
# how often to pull new tickets, how far back to keep, how many ticket details to fetch per run
SDP_SYNC_MINUTES=10
SDP_SYNC_DAYS=365
SDP_DETAIL_LIMIT=150
